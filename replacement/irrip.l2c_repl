
#include "cache.h"

#define maxRRPV 3

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// Initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize I-RRIP Design 4 for L2C" << endl;

    for (uint32_t set = 0; set < L2C_SET; set++) {
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            l2_rrpv[set][way] = maxRRPV;
        }
    }
}

// Find replacement victim
uint32_t CACHE::l2c_find_victim(
    uint32_t cpu,
    uint64_t instr_id,
    uint32_t set,
    const BLOCK *current_set,
    uint64_t ip,
    uint64_t full_addr,
    uint32_t type)
{
    while (true) {

        // First preference: evict a data line at RRPV 11
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_rrpv[set][way] == maxRRPV &&
                !current_set[way].instruction) {
                return way;
            }
        }

        // Otherwise, evict any line at RRPV 11
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_rrpv[set][way] == maxRRPV) {
                return way;
            }
        }

        // Age RRPVs, saturating at RRPV 11
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_rrpv[set][way] < maxRRPV) {
                l2_rrpv[set][way]++;
            }
        }
    }
}


void CACHE::l2c_update_replacement_state(
    uint32_t cpu,
    uint32_t set,
    uint32_t way,
    uint64_t full_addr,
    uint64_t ip,
    uint64_t victim_addr,
    uint32_t type,
    uint8_t hit,
    uint8_t isInstruction)
{
    string TYPE_NAME;

    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
        TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
        TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
        TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    if (hit) {
        // Promotion: instruction -> 00, data -> 01
        if (isInstruction)
            l2_rrpv[set][way] = 0;
        else
            l2_rrpv[set][way] = 1;
    }
    else {
        // Insertion: data -> 11
        if (!isInstruction) {
            l2_rrpv[set][way] = maxRRPV;
        }
        else {
            // Instruction insertion:
            // 25% probability -> 01, 75% probability -> 10
            if ((rand() % 100) < 25)
                l2_rrpv[set][way] = 1;
            else
                l2_rrpv[set][way] = 2;
        }
    }
}


